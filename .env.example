# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://ethixweb_admin:<password>@cluster0.mongodb.net/ethixweb?retryWrites=true&w=majority

# Admin JWT Signing Secret
JWT_SECRET=super-secure-ethixweb-jwt-token-secret-change-in-production-2026

# Site URL for metadata & canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Note: Administrator accounts are stored and hashed with bcrypt directly in the MongoDB `admins` collection.
