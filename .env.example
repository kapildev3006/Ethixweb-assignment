# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-domain>/ethixweb?retryWrites=true&w=majority

# Admin Authentication Secret (Generate a strong 32+ character random secret)
AUTH_SECRET=your_high_entropy_auth_secret_here

# Site URL for metadata & canonical URLs
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Cloudinary Assets Storage (Optional / Production Media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Note: Administrator accounts are stored and hashed with bcrypt directly in the MongoDB `admins` collection.
